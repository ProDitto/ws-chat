  "quikchat-backend/.env.example": "# Server Configuration\nPORT=8080\n\n# Database Configuration\nDATABASE_URL=\"postgres://user:password@db:5432/quikchat?sslmode=disable\"\n\n# Redis Configuration\nREDIS_ADDRESS=\"redis:6379\"\n\n# JWT Configuration\nJWT_SECRET_KEY=\"your-super-secret-key\"\nJWT_ACCESS_TOKEN_EXPIRY_MINUTES=15\nJWT_REFRESH_TOKEN_EXPIRY_DAYS=7\n",
