  "quikchat-frontend/package.json": "{\n  \"name\": \"quikchat-frontend\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Vanilla JS frontend for QuikChat\",\n  \"main\": \"src/index.js\",\n  \"scripts\": {\n    \"build:css\": \"tailwindcss -i ./src/styles/input.css -o ./public/styles/tailwind.css\",\n    \"watch:css\": \"tailwindcss -i ./src/styles/input.css -o ./public/styles/tailwind.css --watch\",\n    \"dev\": \"npm run watch:css\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"devDependencies\": {\n    \"autoprefixer\": \"^10.4.19\",\n    \"postcss\": \"^8.4.38\",\n    \"tailwindcss\": \"^3.4.3\"\n  }\n}\n```",
